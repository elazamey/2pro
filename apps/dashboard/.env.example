# Copy to .env and fill in.
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:  http://localhost:3000
#   Callback URL:  http://localhost:3000/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated scopes to request (default: repo read:user read:org)
GITHUB_SCOPES=repo,read:user,read:org
# Secret used to sign session cookies (any long random string)
SESSION_SECRET=please-change-me-to-a-long-random-string
# Fallback Personal Access Token (optional). If set, users not logged in
# will see data from this token (useful for read-only public dashboards).
FALLBACK_TOKEN=
# Port / host
PORT=3000
HOST=0.0.0.0
