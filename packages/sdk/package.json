{
  "name": "@2pro/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK wrapping the GitHub REST and GraphQL APIs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
