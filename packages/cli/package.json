{
  "name": "@2pro/cli",
  "version": "1.0.0",
  "description": "Command-line interface for GitHub (repos, issues, PRs, Actions)",
  "type": "module",
  "bin": {
    "2pro": "./dist/index.js",
    "gh2": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "keywords": ["github", "cli", "2pro"],
  "license": "MIT",
  "dependencies": {
    "@2pro/sdk": "*",
    "@2pro/figma": "*",
    "@2pro/google": "*",
    "@2pro/gitlab": "*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "@types/node": "^20.11.0"
  }
}
