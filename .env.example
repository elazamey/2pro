# ---------------------------------------------------------------------------
# 2pro reads configuration from environment variables (a local .env file is
# loaded automatically when python-dotenv is installed).  Copy this file to
# `.env` and fill in what you need - every value is optional, 2pro will fall
# back to the `gh` CLI credential when no token is set.
# ---------------------------------------------------------------------------

# Credential.  Resolution order: --token flag > GITHUB_TOKEN > GH_TOKEN >
# GH_ENTERPRISE_TOKEN > stored `2pro auth login` token > `gh auth token`.
GITHUB_TOKEN=
# GH_TOKEN=
# GH_ENTERPRISE_TOKEN=

# GitHub Enterprise: point 2pro at your own instance.
# GITHUB_HOSTNAME=github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3

# Defaults
TWOPRO_PER_PAGE=100
TWOPRO_TIMEOUT=30
TWOPRO_MAX_RETRIES=3
TWOPRO_USER_AGENT=2pro
# TWOPRO_VERIFY_SSL=true

# Dashboard (`2pro serve`)
TWOPRO_HOST=0.0.0.0
TWOPRO_PORT=8000
