# Copy to .env and fill in your secrets.
# Required for the dashboard's GitHub tab (at minimum):
GITHUB_TOKEN=
# For GitHub OAuth "Sign in with GitHub" button:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=change-me-to-a-long-random-string
# Optional services:
FIGMA_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Webhook secrets (set these in GitHub/GitLab repo webhook settings)
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
# Linear & Notion (optional — can also be entered in the dashboard per-session)
LINEAR_API_KEY=
NOTION_TOKEN=
PORT=3000
PUBLIC_BASE_URL=
